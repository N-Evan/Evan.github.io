---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GlitchText from "../../components/chrome/GlitchText.astro";
import RevealOnScroll from "../../components/chrome/RevealOnScroll.astro";
import HoloDivider from "../../components/chrome/HoloDivider.astro";
import DataChip from "../../components/chrome/DataChip.astro";
import MarqueeTicker from "../../components/chrome/MarqueeTicker.astro";
import { withBase } from "../../lib/url";

const all = await getCollection("posts", ({ data }) => import.meta.env.PROD ? !data.draft : true);
const posts = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Aggregate tags
const tagSet = new Set<string>();
posts.forEach((p) => p.data.tags.forEach((t) => tagSet.add(t)));
const tags = [...tagSet].sort();

const tickerItems = [
  `DEVLOG ENTRIES :: ${posts.length}`,
  "FEED :: /rss.xml",
  "FOCUS :: GAMEPLAY × DESIGN × TOOLING",
  "STATUS :: BROADCASTING",
];

function formatDate(d: Date) {
  return d.toISOString().slice(0, 10);
}
---
<BaseLayout
  title="Devlog — Md. Nurusshafi Evan"
  description="Devlog: post-mortems, design breakdowns, and tooling notes by Md. Nurusshafi Evan — gameplay programmer."
>
  <main class="relative">
    <section class="devlog-hero relative pt-28 pb-12 px-6 max-w-5xl mx-auto">
      <div class="font-terminal text-text-muted text-sm tracking-widest mb-3">
        [ DEV ] &middot; LIVE FEED
      </div>
      <a href={withBase("/")} class="font-terminal text-text-muted hover:text-neon-cyan inline-block mb-6">← BACK TO PORTFOLIO</a>
      <RevealOnScroll>
        <GlitchText
          as="h1"
          text="// DEVLOG"
          class="font-pixel text-neon-magenta text-3xl sm:text-5xl block mb-3"
        />
      </RevealOnScroll>
      <RevealOnScroll delay={120}>
        <p class="font-terminal text-text-soft text-lg sm:text-xl max-w-2xl">
          &gt; Working notes from the operator. Post-mortems, design breakdowns, and tooling experiments —
          published as I learn them.
        </p>
      </RevealOnScroll>
      <RevealOnScroll delay={200}>
        <div class="mt-6 flex flex-wrap gap-2">
          <a href={withBase("/rss.xml")} class="font-terminal text-neon-cyan hover:text-neon-magenta border border-dashed border-neon-cyan px-3 py-1 text-sm tracking-widest">
            ◆ RSS FEED
          </a>
          {tags.map((t) => <DataChip tone="cyan">#{t}</DataChip>)}
        </div>
      </RevealOnScroll>
    </section>

    <div class="devlog-ticker"><MarqueeTicker items={tickerItems} tone="magenta" speed={36} /></div>

    <section class="devlog-list py-16 px-6 max-w-5xl mx-auto">
      {posts.length === 0 ? (
        <p class="font-terminal text-text-muted">&gt; No entries yet. First transmission incoming.</p>
      ) : (
        <ul class="devlog-grid">
          {posts.map((p, i) => (
            <li>
              <RevealOnScroll from="up" delay={i * 60}>
                <a href={withBase(`/devlog/${p.id}`)} class="devlog-card" data-tilt>
                  <div class="devlog-card__head">
                    <span class="devlog-card__id font-pixel">ENTRY {String(posts.length - i).padStart(2, "0")}</span>
                    <span class="devlog-card__date font-terminal">{formatDate(p.data.date)}</span>
                  </div>
                  <h2 class="devlog-card__title font-pixel">{p.data.title}</h2>
                  <p class="devlog-card__summary font-body">{p.data.summary}</p>
                  <div class="devlog-card__tags">
                    {p.data.tags.map((t) => <DataChip tone="cyan">#{t}</DataChip>)}
                  </div>
                  <span class="devlog-card__cta font-terminal">[ READ ENTRY ▶ ]</span>
                </a>
              </RevealOnScroll>
            </li>
          ))}
        </ul>
      )}
    </section>
  </main>
</BaseLayout>

<style>
  .devlog-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .devlog-card {
    display: block;
    position: relative;
    border: 1px solid var(--neon-magenta);
    background: linear-gradient(180deg, rgba(28,13,61,0.85), rgba(7,3,15,0.95));
    box-shadow: 0 0 14px rgba(255,46,136,0.18);
    padding: 1.2rem 1.3rem 1.3rem;
    color: inherit;
    transition: transform 250ms ease-out, box-shadow 250ms ease, border-color 200ms;
    overflow: hidden;
  }
  .devlog-card:hover {
    border-color: var(--neon-cyan);
    box-shadow: 0 0 22px rgba(255,46,136,0.4), 0 0 40px rgba(0,240,255,0.18);
  }
  .devlog-card::before {
    content: "";
    position: absolute; inset: -1px;
    pointer-events: none;
    background: linear-gradient(120deg, transparent 30%, rgba(0,240,255,0.18) 50%, transparent 70%);
    transform: translateX(-100%);
    transition: transform 800ms ease;
  }
  .devlog-card:hover::before { transform: translateX(100%); }

  .devlog-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed var(--text-muted);
  }
  .devlog-card__id {
    color: var(--neon-magenta);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-shadow: 0 0 6px var(--neon-magenta);
  }
  .devlog-card__date {
    color: var(--text-muted);
    font-size: 0.95rem;
    letter-spacing: 0.1em;
  }
  .devlog-card__title {
    color: var(--neon-magenta);
    font-size: 1.05rem;
    line-height: 1.3;
    text-shadow: 0 0 8px var(--neon-magenta);
    margin: 0 0 0.5rem;
  }
  @media (min-width: 640px) {
    .devlog-card__title { font-size: 1.25rem; }
  }
  .devlog-card__summary {
    color: var(--text-soft);
    line-height: 1.55;
    margin: 0 0 0.85rem;
  }
  .devlog-card__tags {
    display: flex; flex-wrap: wrap; gap: 0.4rem;
    margin-bottom: 0.9rem;
  }
  .devlog-card__cta {
    color: var(--neon-cyan);
    font-size: 0.95rem;
    letter-spacing: 0.15em;
    text-shadow: 0 0 6px var(--neon-cyan);
    opacity: 0.55;
    transition: opacity 200ms ease;
  }
  .devlog-card:hover .devlog-card__cta { opacity: 1; }
</style>

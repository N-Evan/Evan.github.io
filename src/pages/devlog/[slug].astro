---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GlitchText from "../../components/chrome/GlitchText.astro";
import DataChip from "../../components/chrome/DataChip.astro";
import NeonButton from "../../components/chrome/NeonButton.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  );
  const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: sorted[i + 1] ?? null, // older
      next: sorted[i - 1] ?? null, // newer
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

function formatDate(d: Date) {
  return d.toISOString().slice(0, 10);
}

// Reading time estimate
const wordCount = entry.body ? entry.body.trim().split(/\s+/).length : 0;
const readMinutes = Math.max(1, Math.round(wordCount / 220));

const canonical = new URL(`/devlog/${entry.id}`, Astro.site).toString();

// JSON-LD article schema for SEO
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: entry.data.title,
  description: entry.data.summary,
  datePublished: entry.data.date.toISOString(),
  dateModified: (entry.data.updated ?? entry.data.date).toISOString(),
  author: {
    "@type": "Person",
    name: entry.data.author,
    url: Astro.site?.toString(),
  },
  publisher: {
    "@type": "Person",
    name: entry.data.author,
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  keywords: entry.data.tags.join(", "),
  image: new URL(entry.data.cover ?? "/og-image.png", Astro.site).toString(),
};
---
<BaseLayout
  title={`${entry.data.title} — Devlog · Md. Nurusshafi Evan`}
  description={entry.data.summary}
  ogImage={entry.data.cover ?? "/og-image.png"}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <main class="post relative max-w-3xl mx-auto px-6 py-16">
    <a href="/devlog" class="font-terminal text-text-muted hover:text-neon-cyan inline-block mb-8">← BACK TO DEVLOG</a>

    <header class="post__header">
      <div class="font-terminal text-text-muted text-xs tracking-widest mb-3">
        [ ENTRY ] &middot; {formatDate(entry.data.date)} &middot; ~{readMinutes} MIN READ
      </div>
      <GlitchText
        as="h1"
        text={entry.data.title}
        class="font-pixel text-neon-magenta text-2xl sm:text-4xl block mb-4 leading-tight"
      />
      <p class="font-terminal text-text-soft text-lg leading-relaxed">
        &gt; {entry.data.summary}
      </p>
      <div class="post__tags mt-4 flex flex-wrap gap-2">
        {entry.data.tags.map((t) => <DataChip tone="cyan">#{t}</DataChip>)}
      </div>
      <hr class="post__rule" />
    </header>

    <article class="post__body">
      <Content />
    </article>

    <footer class="post__footer">
      <hr class="post__rule" />
      <div class="post__author font-terminal">
        Written by
        <a href="/" class="post__author-name">{entry.data.author}</a>
        ·
        <a href="/rss.xml" class="post__rss">RSS FEED</a>
      </div>

      <nav class="post__nav">
        {prev ? (
          <a href={`/devlog/${prev.id}`} class="post__nav-link post__nav-link--prev">
            <span class="post__nav-label font-terminal">◀ OLDER</span>
            <span class="post__nav-title font-pixel">{prev.data.title}</span>
          </a>
        ) : <span></span>}
        {next ? (
          <a href={`/devlog/${next.id}`} class="post__nav-link post__nav-link--next">
            <span class="post__nav-label font-terminal">NEWER ▶</span>
            <span class="post__nav-title font-pixel">{next.data.title}</span>
          </a>
        ) : <span></span>}
      </nav>

      <div class="post__cta">
        <NeonButton href="/#comms" tone="magenta">[ TRANSMIT REPLY ]</NeonButton>
        <NeonButton href="/devlog" tone="cyan">◆ ALL ENTRIES</NeonButton>
      </div>
    </footer>
  </main>
</BaseLayout>

<style is:global>
  .post__rule {
    border: 0;
    border-top: 1px dashed var(--neon-cyan);
    margin: 2rem 0;
    box-shadow: 0 0 6px rgba(0, 240, 255, 0.3);
  }
  .post__body { color: var(--text-soft); font-size: 1.05rem; line-height: 1.75; }
  .post__body h2 {
    font-family: theme("fontFamily.pixel");
    color: var(--neon-cyan);
    font-size: 1.15rem;
    margin: 2.5rem 0 0.8rem;
    text-shadow: 0 0 6px var(--neon-cyan);
  }
  .post__body h3 {
    font-family: theme("fontFamily.terminal");
    color: var(--neon-magenta);
    font-size: 1.2rem;
    margin: 1.6rem 0 0.6rem;
    letter-spacing: 0.05em;
  }
  .post__body p { margin: 0.9rem 0; }
  .post__body strong { color: var(--neon-magenta); text-shadow: 0 0 4px var(--neon-magenta); }
  .post__body em { color: var(--neon-cyan); font-style: normal; }
  .post__body a {
    color: var(--neon-cyan);
    border-bottom: 1px dashed var(--neon-cyan);
  }
  .post__body a:hover {
    color: var(--neon-magenta);
    border-color: var(--neon-magenta);
    text-shadow: 0 0 6px var(--neon-magenta);
  }
  .post__body ul, .post__body ol {
    margin: 0.9rem 0 0.9rem 1.4rem;
  }
  .post__body ul { list-style: square; }
  .post__body ul::marker, .post__body ol::marker { color: var(--neon-magenta); }
  .post__body li { margin: 0.4rem 0; }
  .post__body code {
    background: rgba(0, 240, 255, 0.08);
    border: 1px solid rgba(0, 240, 255, 0.3);
    padding: 0.05rem 0.35rem;
    color: var(--neon-cyan);
    font-size: 0.92em;
    font-family: ui-monospace, "JetBrains Mono", monospace;
  }
  .post__body pre {
    background: rgba(7, 3, 15, 0.7);
    border: 1px solid var(--neon-magenta);
    padding: 1rem 1.2rem;
    overflow-x: auto;
    margin: 1.2rem 0;
    box-shadow: 0 0 10px rgba(255, 46, 136, 0.2);
  }
  .post__body pre code {
    background: transparent;
    border: none;
    padding: 0;
    color: var(--text-soft);
  }
  .post__body blockquote {
    border-left: 3px solid var(--neon-magenta);
    padding: 0.4rem 1rem;
    margin: 1.2rem 0;
    background: rgba(255, 46, 136, 0.08);
    color: var(--text-soft);
    font-style: italic;
  }

  .post__author { color: var(--text-muted); font-size: 0.95rem; letter-spacing: 0.1em; }
  .post__author a { color: var(--neon-cyan); }
  .post__author-name { text-shadow: 0 0 6px var(--neon-cyan); }

  .post__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .post__nav-link {
    border: 1px solid var(--neon-magenta);
    background: linear-gradient(180deg, rgba(28,13,61,0.7), rgba(7,3,15,0.85));
    padding: 0.85rem 1rem;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    transition: transform 200ms, box-shadow 200ms;
    min-width: 0;
  }
  .post__nav-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 12px rgba(255, 46, 136, 0.4);
  }
  .post__nav-link--next { text-align: right; }
  .post__nav-label { color: var(--text-muted); font-size: 0.78rem; letter-spacing: 0.18em; }
  .post__nav-title {
    color: var(--neon-magenta);
    font-size: 0.78rem;
    line-height: 1.3;
    text-shadow: 0 0 6px var(--neon-magenta);
  }

  .post__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
    justify-content: center;
  }
</style>

---
import { codeToHtml } from "shiki";

interface Snippet {
  title: string;
  language: string;
  code: string;
  caption?: string;
}
interface Props {
  snippets: Snippet[];
}
const { snippets } = Astro.props;

// Shiki "synthwave-84" theme matches the cyberpunk palette out of the box.
const rendered = await Promise.all(
  snippets.map(async (s) => {
    let html = "";
    try {
      html = await codeToHtml(s.code, {
        lang: s.language,
        theme: "synthwave-84",
      });
    } catch {
      // Unknown language → render as plain text in the same theme.
      html = await codeToHtml(s.code, {
        lang: "text",
        theme: "synthwave-84",
      });
    }
    return { ...s, html };
  })
);
---
{snippets.length > 0 && (
  <section class="code-showcase mt-10">
    <h2 class="font-pixel text-neon-cyan text-xl sm:text-2xl mb-4">// CODE EXTRACTS</h2>
    <div class="code-showcase__list">
      {rendered.map((s, i) => (
        <figure class="snippet" data-snippet-index={i + 1}>
          <figcaption class="snippet__head">
            <span class="snippet__corner">┌</span>
            <span class="snippet__num font-terminal">SNIPPET {String(i + 1).padStart(2, "0")}</span>
            <span class="snippet__title font-terminal">{s.title}</span>
            <span class="snippet__lang font-terminal">.{s.language}</span>
            <button
              type="button"
              class="snippet__copy font-terminal"
              data-copy-target={`snippet-code-${i}`}
              aria-label="Copy snippet"
            >[ COPY ]</button>
          </figcaption>
          <div class="snippet__code" id={`snippet-code-${i}`} set:html={s.html}></div>
          {s.caption && <p class="snippet__caption font-terminal">&gt; {s.caption}</p>}
        </figure>
      ))}
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLButtonElement>(".snippet__copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = btn.dataset.copyTarget;
      const target = id ? document.getElementById(id) : null;
      if (!target) return;
      try {
        await navigator.clipboard.writeText(target.innerText.trim());
        const orig = btn.textContent;
        btn.textContent = "[ COPIED ]";
        btn.classList.add("is-copied");
        setTimeout(() => {
          btn.textContent = orig;
          btn.classList.remove("is-copied");
        }, 1600);
      } catch {}
    });
  });
</script>

<style is:global>
  .code-showcase__list { display: flex; flex-direction: column; gap: 1.4rem; }

  .snippet {
    border: 1px solid var(--neon-magenta);
    background: linear-gradient(180deg, rgba(28,13,61,0.85), rgba(7,3,15,0.95));
    box-shadow: 0 0 12px rgba(255, 46, 136, 0.18);
    margin: 0;
  }
  .snippet__head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.85rem;
    background: rgba(255,46,136,0.08);
    border-bottom: 1px dashed var(--neon-magenta);
    font-size: 0.92rem;
    flex-wrap: wrap;
  }
  .snippet__corner {
    color: var(--neon-magenta);
    font-family: theme("fontFamily.pixel");
    text-shadow: 0 0 6px var(--neon-magenta);
  }
  .snippet__num {
    color: var(--neon-magenta);
    text-shadow: 0 0 6px var(--neon-magenta);
    letter-spacing: 0.18em;
    font-size: 0.78rem;
    text-transform: uppercase;
  }
  .snippet__title {
    color: var(--text-soft);
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .snippet__lang {
    color: var(--neon-cyan);
    text-shadow: 0 0 6px var(--neon-cyan);
    letter-spacing: 0.1em;
  }
  .snippet__copy {
    background: transparent;
    color: var(--text-muted);
    border: 1px dashed var(--text-muted);
    padding: 0.2rem 0.5rem;
    cursor: pointer;
    letter-spacing: 0.12em;
    font-size: 0.85rem;
    transition: color 200ms, border-color 200ms, background 200ms;
  }
  .snippet__copy:hover {
    color: var(--neon-cyan);
    border-color: var(--neon-cyan);
    text-shadow: 0 0 6px var(--neon-cyan);
  }
  .snippet__copy.is-copied {
    color: var(--terminal-grn);
    border-color: var(--terminal-grn);
    text-shadow: 0 0 6px var(--terminal-grn);
  }
  .snippet__code {
    overflow-x: auto;
    padding: 0;
    background: transparent;
  }
  .snippet__code pre.shiki {
    margin: 0 !important;
    padding: 1rem 1.2rem !important;
    background: rgba(7, 3, 15, 0.6) !important;
    font-family: "Press Start 2P", monospace;
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .snippet__code pre.shiki code {
    font-family: ui-monospace, "JetBrains Mono", "Fira Code", monospace;
  }
  .snippet__caption {
    padding: 0.5rem 1rem 0.7rem;
    color: var(--text-muted);
    font-size: 0.95rem;
    border-top: 1px dashed var(--text-muted);
  }
</style>

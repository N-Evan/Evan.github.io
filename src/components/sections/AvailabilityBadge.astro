---
import { status, STATE_META } from "../../data/status";
const meta = STATE_META[status.current];
const colorVar =
  meta.color === "magenta" ? "var(--neon-magenta)" :
  meta.color === "cyan"    ? "var(--neon-cyan)"    :
  meta.color === "yellow"  ? "var(--neon-yellow)"  :
                              "var(--text-muted)";
---
<aside class={`avail-badge ${meta.pulse ? "is-pulsing" : ""}`} style={`--avail-color: ${colorVar};`}>
  <span class="avail-badge__rail" aria-hidden="true"></span>
  <span class="avail-badge__dot" aria-hidden="true"></span>
  <div class="avail-badge__text">
    <strong class="avail-badge__label font-terminal">{meta.label}</strong>
    {status.message && (
      <span class="avail-badge__msg font-terminal">{status.message}</span>
    )}
  </div>
  <a href="#comms" class="avail-badge__cta font-terminal">[ HIRE ME ]</a>
</aside>

<style>
  .avail-badge {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 6xl;
    margin: 1.5rem auto 0;
    padding: 0.85rem 1rem 0.85rem 1.4rem;
    background: linear-gradient(90deg, color-mix(in srgb, var(--bg-panel) 85%, transparent), color-mix(in srgb, var(--bg-void) 70%, transparent));
    border: 1px solid var(--avail-color);
    border-left: 4px solid var(--avail-color);
    box-shadow: 0 0 14px color-mix(in srgb, var(--avail-color) 25%, transparent);
    width: min(960px, calc(100% - 3rem));
  }
  .avail-badge__rail {
    position: absolute;
    top: 0; bottom: 0; left: 0;
    width: 4px;
    background: var(--avail-color);
    box-shadow: 0 0 12px var(--avail-color);
  }
  .avail-badge__dot {
    width: 12px; height: 12px;
    border-radius: 50%;
    background: var(--avail-color);
    box-shadow: 0 0 8px var(--avail-color), 0 0 14px var(--avail-color);
    flex-shrink: 0;
  }
  .avail-badge.is-pulsing .avail-badge__dot {
    animation: avail-pulse 1.4s ease-in-out infinite;
  }
  @keyframes avail-pulse {
    0%, 100% { transform: scale(1);   opacity: 1;   }
    50%      { transform: scale(1.4); opacity: 0.5; }
  }
  .avail-badge__text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
    min-width: 0;
  }
  .avail-badge__label {
    color: var(--avail-color);
    font-size: 1rem;
    letter-spacing: 0.18em;
    text-shadow: 0 0 6px var(--avail-color);
  }
  .avail-badge__msg {
    color: var(--text-muted);
    font-size: 0.95rem;
    letter-spacing: 0.05em;
  }
  .avail-badge__cta {
    flex-shrink: 0;
    color: var(--text-soft);
    border: 1px dashed var(--avail-color);
    padding: 0.4rem 0.7rem;
    transition: background 200ms, color 200ms, transform 200ms;
    letter-spacing: 0.12em;
    font-size: 0.95rem;
  }
  .avail-badge__cta:hover {
    background: var(--avail-color);
    color: var(--bg-void);
    transform: translateY(-1px);
    text-shadow: none;
  }
  /* ---------- light: WARNING register ---------- *
     One of two places the alarm treatment is allowed, because this element
     genuinely IS a status alert — the register carries meaning here rather
     than decorating. Hazard stripes, orange field, hard black edges. */
  :global(:root[data-theme="light"]) .avail-badge {
    background: var(--accent-bright);
    border: 2px solid #120d08;
    border-left: 2px solid #120d08;
    box-shadow: none;
    color: #120d08;
  }
  :global(:root[data-theme="light"]) .avail-badge::before,
  :global(:root[data-theme="light"]) .avail-badge::after {
    content: "";
    position: absolute;
    left: 0; right: 0;
    height: 7px;
    background: repeating-linear-gradient(45deg, #120d08 0 8px, transparent 8px 16px);
  }
  :global(:root[data-theme="light"]) .avail-badge::before { top: 0; }
  :global(:root[data-theme="light"]) .avail-badge::after  { bottom: 0; }

  :global(:root[data-theme="light"]) .avail-badge__rail { display: none; }
  :global(:root[data-theme="light"]) .avail-badge__dot {
    background: #120d08;
    border-radius: 0;
    box-shadow: none;
    /* hexagon, not a dot */
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
  }
  :global(:root[data-theme="light"]) .avail-badge__label,
  :global(:root[data-theme="light"]) .avail-badge__msg {
    color: #120d08;
    font-family: var(--font-display);
    font-weight: 700;
  }
  :global(:root[data-theme="light"]) .avail-badge__msg { font-weight: 400; opacity: 0.8; }
  :global(:root[data-theme="light"]) .avail-badge__cta {
    color: #120d08;
    border: 2px solid #120d08;
    border-style: solid;
    font-family: var(--font-display);
    font-weight: 700;
  }
  :global(:root[data-theme="light"]) .avail-badge__cta:hover {
    background: #120d08;
    color: var(--accent-bright);
  }

  @media (max-width: 640px) {
    .avail-badge {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }
    .avail-badge__cta { align-self: stretch; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .avail-badge.is-pulsing .avail-badge__dot { animation: none; }
  }
</style>

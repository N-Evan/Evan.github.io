---
import PixelFrame from "../chrome/PixelFrame.astro";
import DataChip from "../chrome/DataChip.astro";
import GlitchText from "../chrome/GlitchText.astro";
import RevealOnScroll from "../chrome/RevealOnScroll.astro";

const stats: { label: string; value: number; tone: "magenta" | "cyan" | "yellow" }[] = [
  { label: "GAMEPLAY",    value: 90, tone: "magenta" },
  { label: "LEVEL DESIGN",value: 80, tone: "cyan" },
  { label: "VFX",         value: 70, tone: "yellow" },
  { label: "TOOLING",     value: 75, tone: "cyan" },
];

// 8x8 pixel avatar — colors keyed: 0 void, 1 magenta hair, 2 cyan visor,
// 3 skin, 4 jaw, 5 panel, 6 outline cyan
const _ = 0, M = 1, C = 2, S = 3, J = 4, P = 5, O = 6;
const avatar: number[][] = [
  [_, _, M, M, M, M, _, _],
  [_, M, M, M, M, M, M, _],
  [_, M, S, S, S, S, M, _],
  [_, M, S, C, C, S, M, _],
  [_, _, S, S, S, S, _, _],
  [_, _, J, S, S, J, _, _],
  [_, P, C, C, C, C, P, _],
  [_, P, P, P, P, P, P, _],
];
const palette: Record<number, string> = {
  0: "var(--bg-void)",
  1: "var(--neon-magenta)",
  2: "var(--neon-cyan)",
  3: "#f5d4b8",
  4: "#c47b5a",
  5: "var(--bg-panel)",
  6: "var(--neon-cyan)",
};
---
<section id="profile" class="profile relative py-28 px-6 max-w-6xl mx-auto">
  <div class="section-tag font-terminal text-text-muted text-sm tracking-widest mb-3">
    [ 01 ] &middot; OPERATOR DOSSIER
  </div>
  <RevealOnScroll>
    <GlitchText as="h2" text="// OPERATOR PROFILE" class="font-pixel text-neon-cyan text-2xl sm:text-3xl block mb-12" />
  </RevealOnScroll>

  <div class="grid lg:grid-cols-[minmax(0,360px)_minmax(0,1fr)] gap-10 items-start">
    <!-- Character sheet -->
    <RevealOnScroll from="left">
      <div class="char-sheet">
        <PixelFrame tone="cyan">
          <!-- Avatar tile (CSS-art portrait) -->
          <div class="avatar">
            <div class="avatar__grid">
              {avatar.flat().map((v) => (
                <div class="avatar__cell" style={`background:${palette[v]};`} />
              ))}
            </div>
            <div class="avatar__id">UID :: 0xE V A N</div>
          </div>

          <dl class="font-terminal text-base sm:text-lg space-y-1.5 mt-4">
            <div class="row"><dt>CALLSIGN</dt><dd>EVAN</dd></div>
            <div class="row"><dt>CLASS</dt><dd>GAMEPLAY DEV</dd></div>
            <div class="row"><dt>REGION</dt><dd>DHAKA, BD</dd></div>
            <div class="row"><dt>XP</dt><dd>2+ YEARS</dd></div>
            <div class="row"><dt>STATUS</dt><dd class="text-terminal-grn">// ONLINE</dd></div>
          </dl>

          <div class="stats mt-5">
            <p class="font-terminal text-text-muted text-xs tracking-widest mb-2">PROFICIENCY</p>
            {stats.map((s, i) => (
              <div class="stat" style={`--stat-delay:${i * 100}ms;`}>
                <span class="stat__label font-terminal">{s.label}</span>
                <span class={`stat__bar stat__bar--${s.tone}`}>
                  <span class="stat__fill" style={`width:${s.value}%;`}></span>
                </span>
                <span class="stat__num font-terminal">{s.value}</span>
              </div>
            ))}
          </div>

          <div class="mt-5 flex flex-wrap gap-2">
            <DataChip tone="magenta">UNITY</DataChip>
            <DataChip tone="magenta">C#</DataChip>
            <DataChip tone="cyan">BLENDER</DataChip>
            <DataChip tone="cyan">PHOTON</DataChip>
            <DataChip tone="yellow">VFX</DataChip>
          </div>
        </PixelFrame>
      </div>
    </RevealOnScroll>

    <!-- Bio terminal -->
    <RevealOnScroll from="right" delay={120}>
      <div class="bio-terminal">
        <div class="bio-terminal__bar">
          <span class="bio-dot bio-dot--mag"></span>
          <span class="bio-dot bio-dot--yel"></span>
          <span class="bio-dot bio-dot--cyn"></span>
          <span class="bio-terminal__title font-terminal">~/dossier/evan.bio</span>
        </div>
        <div class="bio-terminal__body font-terminal text-base sm:text-lg leading-relaxed text-text-soft">
          <p><span class="bio-prompt">&gt; cat profile.txt</span></p>
          <p>
            I'm Evan. I have been playing video games for as long as I can remember,
            which led to me wondering what it would feel like to create such engaging
            experiences for millions of others to enjoy.
          </p>
          <p>
            My first step into game development started during my undergraduate studies
            when I dabbled in Unity Engine and built an old-school text-based
            choose-your-own-adventure game from a small story I had written. From then
            on I followed indie game developers across multiple platforms to keep up
            with the industry.
          </p>
          <p>
            Right before completing my undergraduate degree I was fortunate enough to
            secure a job at <span class="bio-hl">Brain Station 23</span> on the
            <span class="bio-hl">Studio-23</span> team as a trainee gameplay programmer
            — that kick-started my career and pushed me to pursue this craft to its
            fullest.
          </p>
          <p class="bio-prompt">&gt; <span class="bio-cursor">▮</span></p>
        </div>
      </div>
    </RevealOnScroll>
  </div>
</section>

<style>
  .section-tag { text-shadow: 0 0 6px var(--text-muted); }

  /* Avatar pixel grid */
  .avatar {
    margin: -0.25rem 0 0;
    padding-bottom: 0.4rem;
    border-bottom: 1px dashed var(--text-muted);
  }
  .avatar__grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    aspect-ratio: 1 / 1;
    width: 144px;
    margin-inline: auto;
    border: 1px solid var(--neon-cyan);
    box-shadow: 0 0 12px var(--neon-cyan), inset 0 0 12px rgba(0,240,255,0.18);
    image-rendering: pixelated;
  }
  .avatar__cell { aspect-ratio: 1 / 1; }
  .avatar__id {
    text-align: center;
    margin-top: 0.6rem;
    font-family: theme('fontFamily.terminal');
    color: var(--neon-magenta);
    text-shadow: 0 0 6px var(--neon-magenta);
    font-size: 0.95rem;
    letter-spacing: 0.15em;
  }

  .row { display: flex; justify-content: space-between; gap: 1rem; }
  .row dt { color: var(--text-muted); letter-spacing: 0.15em; font-size: 0.85em; }
  .row dd { color: var(--text-soft); }

  /* Stat bars */
  .stats { padding-top: 0.4rem; border-top: 1px dashed var(--text-muted); }
  .stat {
    display: grid;
    grid-template-columns: 110px 1fr 36px;
    align-items: center;
    gap: 0.5rem;
    padding: 0.2rem 0;
  }
  .stat__label { font-size: 0.85em; letter-spacing: 0.12em; color: var(--text-muted); }
  .stat__bar {
    position: relative;
    height: 8px;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--bar-color);
    --bar-color: var(--text-muted);
    overflow: hidden;
  }
  .stat__bar--magenta { --bar-color: var(--neon-magenta); }
  .stat__bar--cyan    { --bar-color: var(--neon-cyan); }
  .stat__bar--yellow  { --bar-color: var(--neon-yellow); }
  .stat__fill {
    display: block;
    height: 100%;
    background: var(--bar-color);
    box-shadow: 0 0 8px var(--bar-color);
    width: 0;
    animation: bar-fill 1.2s cubic-bezier(.2,.8,.2,1) forwards;
    animation-delay: var(--stat-delay, 0ms);
  }
  .reveal:not(.is-visible) .stat__fill { width: 0 !important; animation: none; }
  .reveal.is-visible .stat__fill { animation: bar-fill 1.2s cubic-bezier(.2,.8,.2,1) forwards; animation-delay: var(--stat-delay, 0ms); }
  @keyframes bar-fill { from { width: 0; } }
  .stat__num { text-align: right; color: var(--neon-cyan); font-size: 0.9em; text-shadow: 0 0 6px var(--neon-cyan); }

  /* Bio terminal */
  .bio-terminal {
    border: 2px solid var(--neon-magenta);
    background: linear-gradient(180deg, rgba(28,13,61,0.85), rgba(7,3,15,0.7));
    box-shadow: 0 0 18px rgba(255,46,136,0.18);
  }
  .bio-terminal__bar {
    background: rgba(255,46,136,0.15);
    border-bottom: 1px solid var(--neon-magenta);
    padding: 0.55rem 0.9rem;
    display: flex; align-items: center; gap: 0.55rem;
  }
  .bio-dot { width: 10px; height: 10px; border-radius: 50%; }
  .bio-dot--mag { background: var(--neon-magenta); box-shadow: 0 0 6px var(--neon-magenta); }
  .bio-dot--yel { background: var(--neon-yellow); box-shadow: 0 0 6px var(--neon-yellow); }
  .bio-dot--cyn { background: var(--neon-cyan); box-shadow: 0 0 6px var(--neon-cyan); }
  .bio-terminal__title { color: var(--text-muted); font-size: 0.95rem; margin-left: auto; letter-spacing: 0.1em; }
  .bio-terminal__body { padding: 1.5rem; }
  .bio-terminal__body p { margin: 0.6rem 0; }
  .bio-prompt { color: var(--terminal-grn); text-shadow: 0 0 6px var(--terminal-grn); }
  .bio-hl { color: var(--neon-magenta); text-shadow: 0 0 6px var(--neon-magenta); }
  .bio-cursor { display: inline-block; color: var(--terminal-grn); animation: blink 1s steps(1) infinite; }
  @keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
</style>

---
import GlitchText from "../chrome/GlitchText.astro";
import RevealOnScroll from "../chrome/RevealOnScroll.astro";

const cols: { label: string; icon: string; tone: "magenta" | "cyan" | "yellow"; items: string[] }[] = [
  { label: "ENGINES",     icon: "⚙",  tone: "magenta", items: ["Unity"] },
  { label: "LANGUAGES",   icon: "ƒ",  tone: "cyan",    items: ["C#", "JavaScript", "TypeScript", "GLSL"] },
  { label: "TOOLS",       icon: "✦",  tone: "cyan",    items: ["Blender", "Substance Painter", "Photon", "Adobe Photoshop", "Aseprite", "Git"] },
  { label: "DISCIPLINES", icon: "◇",  tone: "yellow",  items: ["Gameplay Programming", "Level Design", "VFX", "UI / UX", "Tooling"] },
];
---
<section id="loadout" class="loadout relative py-28 px-6 max-w-6xl mx-auto">
  <div class="loadout-maze" aria-hidden="true"></div>
  <div class="section-tag font-terminal text-text-muted text-sm tracking-widest mb-3 relative">
    [ 03 ] &middot; INVENTORY
  </div>
  <RevealOnScroll>
    <GlitchText as="h2" text="// TECH LOADOUT" class="font-pixel text-neon-yellow text-2xl sm:text-3xl block mb-2" />
  </RevealOnScroll>
  <RevealOnScroll delay={120}>
    <p class="font-terminal text-text-muted text-base sm:text-lg mb-12 max-w-2xl">
      &gt; Equipped tools, languages, and disciplines.
    </p>
  </RevealOnScroll>

  <div class="loadout-grid grid gap-5 md:grid-cols-2 lg:grid-cols-4">
    {cols.map((col, i) => (
      <RevealOnScroll from="up" delay={i * 100}>
        <div class={`load-col load-col--${col.tone}`}>
          <div class="load-col__head">
            <span class="load-col__icon">{col.icon}</span>
            <span class="load-col__label font-terminal">{col.label}</span>
            <span class="load-col__count font-terminal">{String(col.items.length).padStart(2, "0")}</span>
          </div>
          <ul class="load-col__list">
            {col.items.map((item, j) => (
              <li class="load-item" style={`--item-delay:${j * 60}ms;`}>
                <span class="load-item__bracket">[</span>
                <span class="load-item__text font-terminal">{item}</span>
                <span class="load-item__bracket">]</span>
              </li>
            ))}
          </ul>
          <div class="load-col__bar" aria-hidden="true">
            <span class="load-col__fill"></span>
          </div>
        </div>
      </RevealOnScroll>
    ))}
  </div>
</section>

<style>
  .section-tag { text-shadow: 0 0 6px var(--text-muted); }

  /* Pacman maze backdrop */
  .loadout { isolation: isolate; }
  .loadout-maze {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.10;
    z-index: 0;
    mix-blend-mode: screen;
    background-image:
      /* dot row */
      radial-gradient(circle, var(--neon-yellow) 0 1.2px, transparent 1.6px),
      /* maze grid */
      linear-gradient(to right,  var(--neon-cyan) 0 1px, transparent 1px),
      linear-gradient(to bottom, var(--neon-cyan) 0 1px, transparent 1px),
      /* inner "pellet" cells */
      repeating-linear-gradient(90deg, transparent 0 40px, rgba(0,240,255,0.18) 40px 41px),
      repeating-linear-gradient(0deg,  transparent 0 40px, rgba(0,240,255,0.18) 40px 41px);
    background-size:
      40px 40px,
      40px 40px,
      40px 40px,
      80px 80px,
      80px 80px;
    background-position: 20px 20px, 0 0, 0 0, 0 0, 0 0;
    animation: loadout-maze-scroll 60s linear infinite;
    mask-image: linear-gradient(180deg, transparent 0, #000 18%, #000 82%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 18%, #000 82%, transparent 100%);
  }
  @keyframes loadout-maze-scroll {
    from { background-position: 20px 20px, 0 0, 0 0, 0 0, 0 0; }
    to   { background-position: 20px 60px, 0 40px, 0 40px, 0 80px, 0 80px; }
  }
  .loadout-grid, .loadout > .reveal, .loadout > .section-tag { position: relative; z-index: 1; }

  .load-col {
    --tone: var(--neon-cyan);
    position: relative;
    background:
      linear-gradient(180deg, rgba(28,13,61,0.7), rgba(7,3,15,0.85)),
      repeating-linear-gradient(45deg, transparent 0 8px, rgba(255,255,255,0.02) 8px 9px);
    border: 1px solid var(--tone);
    box-shadow: 0 0 12px color-mix(in srgb, var(--tone) 25%, transparent), inset 0 0 24px rgba(0,0,0,0.4);
    padding: 1.1rem 1rem 1rem;
    height: 100%;
    transition: transform 250ms ease, box-shadow 250ms ease;
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
  }
  .load-col:hover { transform: translateY(-3px); box-shadow: 0 0 20px color-mix(in srgb, var(--tone) 50%, transparent); }
  .load-col--magenta { --tone: var(--neon-magenta); }
  .load-col--cyan    { --tone: var(--neon-cyan); }
  .load-col--yellow  { --tone: var(--neon-yellow); }

  .load-col__head {
    display: flex; align-items: center; gap: 0.55rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px dashed var(--tone);
    margin-bottom: 0.85rem;
  }
  .load-col__icon {
    color: var(--tone);
    font-size: 1.4rem;
    text-shadow: 0 0 8px var(--tone);
  }
  .load-col__label {
    color: var(--text-soft);
    letter-spacing: 0.18em;
    font-size: 1rem;
    flex: 1;
  }
  .load-col__count {
    color: var(--tone);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    border: 1px solid var(--tone);
    padding: 0.05rem 0.4rem;
  }

  .load-col__list { display: flex; flex-direction: column; gap: 0.55rem; }
  .load-item {
    display: flex; align-items: center; gap: 0.4rem;
    padding: 0.3rem 0.5rem;
    border-left: 2px solid var(--tone);
    background: rgba(255,255,255,0.02);
    transition: background 200ms ease, padding-left 200ms ease;
    opacity: 0;
    animation: load-item-in 0.5s cubic-bezier(.2,.8,.2,1) forwards;
    animation-delay: var(--item-delay, 0ms);
  }
  .reveal:not(.is-visible) .load-item { animation: none; opacity: 0; }
  .reveal.is-visible .load-item { animation: load-item-in 0.5s cubic-bezier(.2,.8,.2,1) forwards; animation-delay: var(--item-delay, 0ms); }
  @keyframes load-item-in {
    from { opacity: 0; transform: translateX(-8px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  .load-item:hover {
    background: rgba(255,255,255,0.05);
    padding-left: 0.85rem;
  }
  .load-item__bracket { color: var(--text-muted); font-family: theme('fontFamily.terminal'); }
  .load-item__text { color: var(--text-soft); font-size: 1rem; letter-spacing: 0.05em; }

  .load-col__bar {
    margin-top: 1rem;
    height: 4px;
    background: rgba(255,255,255,0.04);
    overflow: hidden;
  }
  .load-col__fill {
    display: block;
    height: 100%;
    width: 0;
    background: var(--tone);
    box-shadow: 0 0 6px var(--tone);
    animation: load-fill 1.4s cubic-bezier(.2,.8,.2,1) forwards;
  }
  .reveal:not(.is-visible) .load-col__fill { width: 0 !important; animation: none; }
  .reveal.is-visible .load-col__fill { animation: load-fill 1.4s cubic-bezier(.2,.8,.2,1) forwards; }
  @keyframes load-fill { to { width: 100%; } }
</style>

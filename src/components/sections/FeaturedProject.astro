---
import type { CollectionEntry } from "astro:content";
import DataChip from "../chrome/DataChip.astro";
import NeonButton from "../chrome/NeonButton.astro";
import { withBase } from "../../lib/url";

interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const p = project.data;

const linkItems: { label: string; href: string }[] = [];
if (p.links?.steam)   linkItems.push({ label: "STEAM",   href: p.links.steam });
if (p.links?.itch)    linkItems.push({ label: "ITCH",    href: p.links.itch });
if (p.links?.github)  linkItems.push({ label: "GITHUB",  href: p.links.github });
if (p.links?.youtube) linkItems.push({ label: "YOUTUBE", href: p.links.youtube });
---
<article class="featured" data-tilt>
  <span class="featured__corner featured__corner--tl">┌</span>
  <span class="featured__corner featured__corner--tr">┐</span>
  <span class="featured__corner featured__corner--bl">└</span>
  <span class="featured__corner featured__corner--br">┘</span>

  <div class="featured__badge">
    <span class="featured__badge-dot"></span>
    <span class="font-pixel featured__badge-text">FEATURED MISSION</span>
  </div>

  <a class="featured__inner" href={withBase(`/projects/${project.id}`)}>
    <div class="featured__thumb">
      <img
        src={withBase(p.thumb)}
        alt={`${p.title} title art`}
        width="900"
        height="450"
        loading="eager"
        decoding="async"
      />
      <div class="featured__scan"></div>
      <div class="featured__grid"></div>
    </div>

    <div class="featured__body">
      <div class="featured__meta">
        <span class="font-terminal featured__id">M-01</span>
        <span class="featured__divider"></span>
        <span class="font-terminal featured__year">{p.year}</span>
        <span class="featured__divider"></span>
        <span class="font-terminal featured__status">
          <span class="featured__status-dot"></span>
          {p.status === "shipped" ? "SHIPPED" : p.status.toUpperCase()}
        </span>
      </div>

      <h2 class="featured__title font-pixel">{p.title}</h2>
      <p class="featured__tagline font-terminal">{p.tagline}</p>

      <div class="featured__stats font-terminal">
        <div><span class="k">STUDIO</span><span class="v">{p.studio ?? "PERSONAL"}</span></div>
        <div><span class="k">TEAM</span><span class="v">{p.teamSize}</span></div>
        <div><span class="k">DURATION</span><span class="v">{p.duration}</span></div>
        <div><span class="k">ROLE</span><span class="v">{p.role}</span></div>
      </div>

      <div class="featured__chips">
        {p.platforms.map((pl) => <DataChip tone="cyan">{pl}</DataChip>)}
        {p.tech.slice(0, 3).map((t) => <DataChip tone="magenta">{t}</DataChip>)}
      </div>
    </div>
  </a>

  {linkItems.length > 0 && (
    <div class="featured__links">
      <NeonButton href={withBase(`/projects/${project.id}`)} tone="magenta">▶ ENTER MISSION</NeonButton>
      {linkItems.map((l) => <NeonButton href={l.href} tone="cyan">{l.label}</NeonButton>)}
    </div>
  )}
</article>

<style>
  .featured {
    position: relative;
    border: 2px solid var(--neon-magenta);
    background:
      linear-gradient(180deg, rgba(28,13,61,0.85), rgba(7,3,15,0.95)),
      repeating-linear-gradient(45deg, transparent 0 12px, rgba(255,46,136,0.025) 12px 13px);
    box-shadow:
      0 0 0 6px var(--bg-void),
      0 0 22px rgba(255, 46, 136, 0.4),
      0 0 60px rgba(255, 46, 136, 0.18),
      0 12px 40px rgba(0,0,0,0.7);
    padding: 1.4rem;
    margin-bottom: 3rem;
    transform-style: preserve-3d;
    transition: box-shadow 350ms ease, transform 250ms ease-out;
    overflow: hidden;
  }
  .featured:hover {
    box-shadow:
      0 0 0 6px var(--bg-void),
      0 0 30px rgba(255, 46, 136, 0.6),
      0 0 80px rgba(255, 46, 136, 0.3),
      0 16px 48px rgba(0,0,0,0.8);
  }
  .featured::before {
    content: "";
    position: absolute; inset: -2px;
    pointer-events: none;
    background: linear-gradient(120deg, transparent 30%, rgba(0,240,255,0.18) 50%, transparent 70%);
    transform: translateX(-100%);
    transition: transform 1000ms ease;
  }
  .featured:hover::before { transform: translateX(100%); }

  .featured__corner {
    position: absolute;
    color: var(--neon-magenta);
    font-family: theme("fontFamily.pixel");
    font-size: 1.4rem;
    text-shadow: 0 0 8px var(--neon-magenta);
    z-index: 4;
  }
  .featured__corner--tl { top: 0.4rem; left: 0.5rem; }
  .featured__corner--tr { top: 0.4rem; right: 0.5rem; }
  .featured__corner--bl { bottom: 0.4rem; left: 0.5rem; }
  .featured__corner--br { bottom: 0.4rem; right: 0.5rem; }

  .featured__badge {
    position: absolute;
    top: -1px; right: 2.6rem;
    transform: translateY(-50%);
    background: var(--bg-void);
    border: 1px solid var(--neon-magenta);
    padding: 0.35rem 0.7rem;
    display: inline-flex; align-items: center; gap: 0.4rem;
    z-index: 3;
    box-shadow: 0 0 8px var(--neon-magenta);
  }
  .featured__badge-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--neon-magenta);
    box-shadow: 0 0 6px var(--neon-magenta);
    animation: feat-blink 1.4s ease-in-out infinite;
  }
  @keyframes feat-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
  .featured__badge-text {
    font-size: 0.65rem;
    color: var(--neon-magenta);
    text-shadow: 0 0 6px var(--neon-magenta);
    letter-spacing: 0.18em;
  }

  .featured__inner {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
    color: inherit;
    text-decoration: none;
  }
  @media (min-width: 900px) {
    .featured__inner { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: stretch; }
  }

  .featured__thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--bg-void);
    border: 1px solid var(--neon-magenta);
    overflow: hidden;
  }
  .featured__thumb img {
    width: 100%; height: 100%;
    object-fit: contain;
    image-rendering: pixelated;
    transition: transform 800ms cubic-bezier(.2,.8,.2,1), filter 400ms ease;
    filter: saturate(0.9);
  }
  .featured:hover .featured__thumb img {
    transform: scale(1.05);
    filter: saturate(1.25) brightness(1.12);
  }
  .featured__scan {
    position: absolute; left: 0; right: 0; height: 30%;
    top: -30%;
    background: linear-gradient(180deg, transparent, rgba(0,240,255,0.2), transparent);
    pointer-events: none;
  }
  .featured:hover .featured__scan { animation: feat-scan 2s ease-in-out infinite; }
  @keyframes feat-scan {
    0%   { top: -30%; }
    100% { top: 110%; }
  }
  .featured__grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(to right,  rgba(0,240,255,0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0,240,255,0.08) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
  }

  .featured__body { display: flex; flex-direction: column; gap: 0.8rem; }
  .featured__meta {
    display: flex; align-items: center; gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
  }
  .featured__id     { color: var(--neon-magenta); text-shadow: 0 0 6px var(--neon-magenta); }
  .featured__year   { color: var(--text-muted); }
  .featured__divider {
    width: 4px; height: 4px; border-radius: 50%;
    background: var(--text-muted);
  }
  .featured__status {
    display: inline-flex; align-items: center; gap: 0.35rem;
    color: var(--terminal-grn);
    text-shadow: 0 0 6px var(--terminal-grn);
  }
  .featured__status-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--terminal-grn);
    box-shadow: 0 0 6px var(--terminal-grn);
    animation: feat-blink 2s ease-in-out infinite;
  }

  .featured__title {
    color: var(--neon-magenta);
    font-size: 1.5rem;
    line-height: 1.1;
    text-shadow: 0 0 10px var(--neon-magenta);
    margin: 0;
  }
  @media (min-width: 900px) { .featured__title { font-size: 1.9rem; } }

  .featured__tagline {
    color: var(--text-soft);
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .featured__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.4rem 1rem;
    margin-top: 0.4rem;
    padding: 0.7rem 0.9rem;
    border: 1px dashed var(--text-muted);
    background: rgba(255,255,255,0.02);
    font-size: 0.95rem;
  }
  .featured__stats > div { display: flex; justify-content: space-between; gap: 0.5rem; }
  .featured__stats .k { color: var(--text-muted); letter-spacing: 0.1em; }
  .featured__stats .v { color: var(--text-soft); text-align: right; }

  .featured__chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.2rem; }
  .featured__links {
    display: flex; flex-wrap: wrap; gap: 0.6rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--neon-magenta);
  }
</style>

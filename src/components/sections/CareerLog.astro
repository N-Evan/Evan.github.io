---
import GlitchText from "../chrome/GlitchText.astro";
import RevealOnScroll from "../chrome/RevealOnScroll.astro";

const entries = [
  {
    stamp: "2023 — PRESENT",
    title: "Gameplay Programmer",
    org: "Studio-23 · Brain Station 23",
    body: "Shipped Silent Scream and supported XBox port work. Built tooling, gameplay systems, and feel polish across multiple titles.",
    tone: "magenta" as const,
  },
  {
    stamp: "2022 — 2023",
    title: "Trainee Gameplay Programmer",
    org: "Studio-23 · Brain Station 23",
    body: "Joined the team while finishing undergrad. Worked on VR Football for Meta Quest 2 and started High Noon — a real-time PvP duel game.",
    tone: "cyan" as const,
  },
  {
    stamp: "2018 — 2022",
    title: "Undergraduate · Computer Science",
    org: "[ FILL ME IN: school, focus areas, formative projects ]",
    body: "First serious dive into Unity, building text-based adventures, prototypes, and learning the craft.",
    tone: "yellow" as const,
  },
];
---
<section id="career" class="career relative py-28 px-6 max-w-4xl mx-auto">
  <div class="section-tag font-terminal text-text-muted text-sm tracking-widest mb-3">
    [ 04 ] &middot; HISTORY
  </div>
  <RevealOnScroll>
    <GlitchText as="h2" text="// CAREER LOG" class="font-pixel text-neon-cyan text-2xl sm:text-3xl block mb-12" />
  </RevealOnScroll>

  <ol class="timeline">
    <span class="timeline__rail" aria-hidden="true"></span>
    {entries.map((e, i) => (
      <RevealOnScroll from={i % 2 === 0 ? "left" : "right"} delay={i * 100}>
        <li class={`tl-entry tl-entry--${e.tone} ${i % 2 === 0 ? "is-left" : "is-right"}`}>
          <span class="tl-node" aria-hidden="true"></span>
          <div class="tl-card">
            <div class="tl-stamp font-terminal">
              <span class="tl-stamp__id">ENTRY {String(entries.length - i).padStart(2, "0")}</span>
              <span class="tl-stamp__date">{e.stamp}</span>
            </div>
            <h3 class="tl-title font-pixel">{e.title}</h3>
            <p class="tl-org font-terminal">{e.org}</p>
            <p class="tl-body font-body">{e.body}</p>
          </div>
        </li>
      </RevealOnScroll>
    ))}
  </ol>
</section>

<style>
  .section-tag { text-shadow: 0 0 6px var(--text-muted); }
  .timeline {
    position: relative;
    list-style: none;
    margin: 0; padding: 0;
  }
  .timeline__rail {
    position: absolute;
    left: 50%; top: 0; bottom: 0;
    width: 2px;
    transform: translateX(-50%);
    background-image: repeating-linear-gradient(
      to bottom,
      var(--neon-cyan) 0,
      var(--neon-cyan) 6px,
      transparent 6px,
      transparent 12px
    );
    box-shadow: 0 0 8px var(--neon-cyan);
    opacity: 0.6;
  }

  .tl-entry {
    --tone: var(--neon-cyan);
    position: relative;
    display: grid;
    grid-template-columns: 1fr 32px 1fr;
    align-items: start;
    margin-bottom: 2.5rem;
  }
  .tl-entry--magenta { --tone: var(--neon-magenta); }
  .tl-entry--cyan    { --tone: var(--neon-cyan); }
  .tl-entry--yellow  { --tone: var(--neon-yellow); }

  .tl-node {
    grid-column: 2;
    width: 18px; height: 18px;
    align-self: start;
    margin-top: 1.4rem;
    margin-inline: auto;
    border: 2px solid var(--tone);
    background: var(--bg-void);
    box-shadow: 0 0 10px var(--tone);
    transform: rotate(45deg);
    position: relative;
    z-index: 2;
  }
  .tl-node::before {
    content: "";
    position: absolute; inset: 3px;
    background: var(--tone);
    box-shadow: 0 0 6px var(--tone);
  }

  .tl-card {
    border: 1px solid var(--tone);
    background: linear-gradient(180deg, rgba(28,13,61,0.85), rgba(7,3,15,0.9));
    box-shadow: 0 0 14px color-mix(in srgb, var(--tone) 25%, transparent);
    padding: 1rem 1.1rem;
    position: relative;
    transition: transform 250ms ease, box-shadow 250ms ease;
  }
  .tl-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 22px color-mix(in srgb, var(--tone) 45%, transparent);
  }
  .tl-entry.is-left  .tl-card { grid-column: 1; text-align: right; }
  .tl-entry.is-right .tl-card { grid-column: 3; text-align: left; }
  .tl-entry.is-left  .tl-card::after,
  .tl-entry.is-right .tl-card::after {
    content: "";
    position: absolute;
    top: 1.5rem;
    width: 24px; height: 1px;
    background: var(--tone);
    box-shadow: 0 0 6px var(--tone);
  }
  .tl-entry.is-left  .tl-card::after { right: -24px; }
  .tl-entry.is-right .tl-card::after { left: -24px; }

  .tl-stamp {
    display: flex; justify-content: space-between; gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    letter-spacing: 0.15em;
    border-bottom: 1px dashed var(--text-muted);
    padding-bottom: 0.4rem;
    margin-bottom: 0.6rem;
  }
  .tl-entry.is-left  .tl-stamp { flex-direction: row-reverse; }
  .tl-stamp__id { color: var(--tone); text-shadow: 0 0 6px var(--tone); }
  .tl-title {
    color: var(--neon-magenta);
    font-size: 0.95rem;
    line-height: 1.3;
    text-shadow: 0 0 6px var(--neon-magenta);
    margin-bottom: 0.3rem;
  }
  .tl-org { color: var(--neon-cyan); font-size: 0.95rem; margin-bottom: 0.5rem; }
  .tl-body { color: var(--text-soft); line-height: 1.6; font-size: 0.98rem; }

  @media (max-width: 768px) {
    .timeline__rail { left: 16px; }
    .tl-entry { grid-template-columns: 32px 1fr; }
    .tl-node { grid-column: 1; }
    .tl-entry .tl-card { grid-column: 2; text-align: left !important; }
    .tl-entry .tl-card::after { left: -24px !important; right: auto !important; }
    .tl-entry .tl-stamp { flex-direction: row !important; }
  }
</style>

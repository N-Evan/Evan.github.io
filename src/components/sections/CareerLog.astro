---
import { getCollection } from "astro:content";
import GlitchText from "../chrome/GlitchText.astro";
import RevealOnScroll from "../chrome/RevealOnScroll.astro";

// Newest first — array order in src/data/career.json is the display order.
// getCollection does not guarantee loader order, so re-sort by it explicitly.
const order = (await import("../../data/career.json")).default.map((e: { id: string }) => e.id);
const collection = await getCollection("career");
const entries = order
  .map((id) => collection.find((e) => e.id === id))
  .filter((e): e is NonNullable<typeof e> => Boolean(e))
  .map((e) => e.data);
---
<section id="career" class="career relative py-28 px-6 max-w-4xl mx-auto">
  <div class="section-tag font-terminal text-text-muted text-sm tracking-widest mb-3">
    [ 04 ] &middot; HISTORY
  </div>
  <RevealOnScroll>
    <GlitchText as="h2" text="// CAREER LOG" class="font-pixel text-neon-cyan text-2xl sm:text-3xl block mb-3" />
  </RevealOnScroll>
  <RevealOnScroll delay={120}>
    <p class="font-terminal text-text-muted text-base sm:text-lg mb-12 max-w-2xl">
      &gt; Roles, shipped titles, and milestones — most recent first.
    </p>
  </RevealOnScroll>

  <RevealOnScroll delay={180}>
    <ul class="tl-legend font-terminal">
      <li class="tl-legend__item tl-entry--role">
        <span class="tl-legend__node" aria-hidden="true"></span>
        <span><b>ROLE</b> &mdash; a job I held</span>
      </li>
      <li class="tl-legend__item tl-entry--milestone">
        <span class="tl-legend__node" aria-hidden="true"><span class="tl-legend__icon">&#10022;</span></span>
        <span><b>EVENT</b> &mdash; a title shipped or milestone hit</span>
      </li>
      <li class="tl-legend__item tl-entry--education">
        <span class="tl-legend__node" aria-hidden="true"></span>
        <span><b>EDU</b> &mdash; study</span>
      </li>
    </ul>
  </RevealOnScroll>

  <ol class="timeline">
    <span class="timeline__rail" aria-hidden="true"></span>
    {entries.map((e, i) => (
      <RevealOnScroll from={i % 2 === 0 ? "left" : "right"} delay={Math.min(i * 70, 360)}>
        <li class={`tl-entry tl-entry--${e.tone} tl-entry--${e.kind} ${i % 2 === 0 ? "is-left" : "is-right"}`}>
          <span class="tl-node" aria-hidden="true">
            {e.kind === "milestone" && e.icon && <span class="tl-node__icon">{e.icon}</span>}
          </span>
          <div class="tl-card">
            <div class="tl-stamp font-terminal">
              <span class="tl-stamp__id">
                {e.kind === "role" ? "ROLE" : e.kind === "education" ? "EDU" : "EVENT"} ·
                {String(entries.length - i).padStart(2, "0")}
              </span>
              <span class="tl-stamp__date">{e.stamp}</span>
            </div>
            <h3 class="tl-title font-pixel">{e.title}</h3>
            {e.org && <p class="tl-org font-terminal">{e.org}</p>}
            <p class="tl-body font-body">{e.detail}</p>
          </div>
        </li>
      </RevealOnScroll>
    ))}
  </ol>
</section>

<style>
  .section-tag { text-shadow: 0 0 6px var(--text-muted); }
  .timeline {
    position: relative;
    list-style: none;
    margin: 0; padding: 0;
    /* Single source of truth for vertical alignment */
    --node-y: 22px;
    --node-size: 18px;
    --node-center: calc(var(--node-y) + var(--node-size) / 2);
    --connector-w: 26px;
    /* Single source of truth for the horizontal axis. The rail and every
       node read this, so they cannot drift apart. */
    --rail-x: 50%;
  }
  .timeline__rail {
    position: absolute;
    left: var(--rail-x); top: 0; bottom: 0;
    width: 2px;
    transform: translateX(-50%);
    background-image: repeating-linear-gradient(
      to bottom,
      var(--neon-cyan) 0,
      var(--neon-cyan) 6px,
      transparent 6px,
      transparent 12px
    );
    box-shadow: 0 0 8px var(--neon-cyan);
    opacity: 0.6;
  }

  .tl-entry {
    --tone: var(--neon-cyan);
    position: relative;
    display: grid;
    grid-template-columns: 1fr 36px 1fr;
    align-items: start;
    margin-bottom: 2rem;
  }
  .tl-entry--magenta { --tone: var(--neon-magenta); }
  .tl-entry--cyan    { --tone: var(--neon-cyan); }
  .tl-entry--yellow  { --tone: var(--neon-yellow); }

  /* Diamond node aligned via shared --node-y */
  /* Legend. The timeline carries three entry kinds and two axes of meaning
     (shape/glyph = kind, colour = tone) with nothing to decode them. */
  .tl-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    margin: -0.5rem 0 2.5rem;
    padding: 0.7rem 0.95rem;
    list-style: none;
    border: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--bg-panel) 45%, transparent);
    font-size: 0.95rem;
    color: var(--text-muted);
  }
  .tl-legend__item {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    --tone: var(--text-muted);
  }
  .tl-legend__item b { color: var(--text-soft); letter-spacing: 0.12em; font-weight: 400; }
  .tl-legend__item.tl-entry--role      { --tone: var(--neon-cyan); }
  .tl-legend__item.tl-entry--milestone { --tone: var(--neon-magenta); }
  .tl-legend__item.tl-entry--education { --tone: var(--neon-yellow); }
  .tl-legend__node {
    width: 14px; height: 14px;
    flex-shrink: 0;
    border: 2px solid var(--tone);
    background: var(--bg-void);
    transform: rotate(45deg);
    display: grid;
    place-items: center;
    position: relative;
  }
  .tl-legend__item.tl-entry--milestone .tl-legend__node {
    width: 17px; height: 17px;
    background: var(--tone);
  }
  .tl-legend__item:not(.tl-entry--milestone) .tl-legend__node::before {
    content: "";
    position: absolute; inset: 2px;
    background: var(--tone);
  }
  .tl-legend__icon {
    transform: rotate(-45deg);
    font-size: 0.6rem;
    line-height: 1;
    color: var(--bg-void);
  }
  @media (max-width: 640px) {
    .tl-legend { font-size: 0.85rem; gap: 0.45rem 1rem; }
  }

  .tl-node {
    /* Anchored to --node-center by transform rather than by a margin
       computed per node size. The old approach needed a hand-written offset
       for every size variant (and a separate one at mobile), so any node
       that wasn't exactly --node-size drifted off the connector. Now every
       node centres on the connector by construction, whatever its size. */
    /* NO grid-column: for an absolutely-positioned grid child, a grid
       placement makes the GRID AREA the containing block, so `left: 50%`
       resolved against the 36px middle column in some engines and against
       a side column in others — which is why the nodes sat far right.
       Without it the containing block is unambiguously the row box, and
       --rail-x lines them up with the rail by construction. */
    position: absolute;
    left: var(--rail-x);
    top: var(--node-center);
    width: var(--node-size);
    height: var(--node-size);
    transform: translate(-50%, -50%) rotate(45deg);
    border: 2px solid var(--tone);
    background: var(--bg-void);
    box-shadow: 0 0 10px var(--tone), 0 0 18px color-mix(in srgb, var(--tone) 40%, transparent);
    z-index: 2;
    display: grid;
    place-items: center;
  }
  .tl-node::before {
    content: "";
    position: absolute; inset: 3px;
    background: var(--tone);
    box-shadow: 0 0 6px var(--tone);
  }
  /* Milestone nodes get a glyph and slightly larger size */
  .tl-entry--milestone .tl-node {
    width: 26px; height: 26px;
  }
  .tl-node__icon {
    transform: rotate(-45deg);
    font-family: theme("fontFamily.terminal");
    font-size: 0.85rem;
    line-height: 1;
    color: var(--bg-void);
    background: var(--tone);
    text-shadow: none;
    width: 100%; height: 100%;
    display: grid;
    place-items: center;
  }
  /* Educational/role pulse */
  .tl-entry--role .tl-node      { animation: tl-pulse-strong 2.4s ease-in-out infinite; }
  .tl-entry--education .tl-node { animation: tl-pulse-soft 3.2s ease-in-out infinite; }
  @keyframes tl-pulse-strong {
    0%, 100% { box-shadow: 0 0 10px var(--tone), 0 0 18px color-mix(in srgb, var(--tone) 40%, transparent); }
    50%      { box-shadow: 0 0 14px var(--tone), 0 0 28px color-mix(in srgb, var(--tone) 60%, transparent); }
  }
  @keyframes tl-pulse-soft {
    0%, 100% { box-shadow: 0 0 8px var(--tone); }
    50%      { box-shadow: 0 0 14px var(--tone); }
  }

  .tl-card {
    border: 1px solid var(--tone);
    background: linear-gradient(180deg, color-mix(in srgb, var(--bg-panel) 85%, transparent), color-mix(in srgb, var(--bg-void) 90%, transparent));
    box-shadow: 0 0 14px color-mix(in srgb, var(--tone) 25%, transparent);
    padding: 1rem 1.1rem;
    position: relative;
    transition: transform 250ms ease, box-shadow 250ms ease;
  }
  .tl-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 22px color-mix(in srgb, var(--tone) 45%, transparent);
  }
  .tl-entry.is-left  .tl-card { grid-column: 1; text-align: right; }
  .tl-entry.is-right .tl-card { grid-column: 3; text-align: left; }

  /* Connector — vertically aligned with the node center via --node-center */
  .tl-card::after {
    content: "";
    position: absolute;
    top: var(--node-center);
    width: var(--connector-w);
    height: 2px;
    transform: translateY(-50%);
    background: var(--tone);
    box-shadow: 0 0 8px var(--tone), 0 0 14px color-mix(in srgb, var(--tone) 50%, transparent);
  }
  .tl-entry.is-left  .tl-card::after { right: calc(var(--connector-w) * -1); }
  .tl-entry.is-right .tl-card::after { left:  calc(var(--connector-w) * -1); }

  /* Milestone cards: subtler, more compact */
  .tl-entry--milestone .tl-card {
    background: linear-gradient(180deg, color-mix(in srgb, var(--bg-panel) 60%, transparent), color-mix(in srgb, var(--bg-void) 75%, transparent));
    border-style: dashed;
  }
  .tl-entry--milestone .tl-title {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
  }

  .tl-stamp {
    display: flex; justify-content: space-between; gap: 0.5rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.15em;
    border-bottom: 1px dashed var(--text-muted);
    padding-bottom: 0.4rem;
    margin-bottom: 0.6rem;
    text-transform: uppercase;
  }
  .tl-entry.is-left  .tl-stamp { flex-direction: row-reverse; }
  .tl-stamp__id { color: var(--tone); text-shadow: 0 0 6px var(--tone); }
  .tl-title {
    color: var(--neon-magenta);
    font-size: 0.92rem;
    line-height: 1.3;
    text-shadow: 0 0 6px var(--neon-magenta);
    margin-bottom: 0.3rem;
  }
  .tl-entry--milestone .tl-title { color: var(--tone); text-shadow: 0 0 6px var(--tone); }
  .tl-org { color: var(--neon-cyan); font-size: 0.92rem; margin-bottom: 0.5rem; }
  .tl-body { color: var(--text-soft); line-height: 1.6; font-size: 0.95rem; }

  @media (max-width: 768px) {
    .timeline {
      --connector-w: 18px;
      --node-y: 20px;
      --node-size: 16px;
    }
    .timeline__rail {
      /* The rail reads --rail-x like everything else; see the override on
         .timeline below. */
      transform: none !important;
    }
    .timeline { --rail-x: 20px; }   /* 40px rail column, so centre = 20px */
    .tl-entry,
    .tl-entry.is-left,
    .tl-entry.is-right {
      grid-template-columns: 40px 1fr !important;
      margin-bottom: 1.6rem;
    }

    /* Milestone nodes shrink slightly on mobile so they fit the rail column.
       No offset needed — the transform anchor handles any size. */
    .tl-entry--milestone .tl-node {
      width: 22px !important;
      height: 22px !important;
    }
    .tl-entry .tl-card,
    .tl-entry.is-left .tl-card,
    .tl-entry.is-right .tl-card {
      grid-column: 2 !important;
      text-align: left !important;
      min-width: 0;
    }
    .tl-entry .tl-card::after,
    .tl-entry.is-left .tl-card::after,
    .tl-entry.is-right .tl-card::after {
      left: calc(var(--connector-w) * -1) !important;
      right: auto !important;
    }
    .tl-entry .tl-stamp,
    .tl-entry.is-left .tl-stamp,
    .tl-entry.is-right .tl-stamp {
      flex-direction: row !important;
    }
    .tl-stamp__id, .tl-stamp__date {
      font-size: 0.7rem;
    }
    .tl-title {
      font-size: 0.85rem;
      word-wrap: break-word;
    }
    .tl-org { font-size: 0.85rem; }
    .tl-body { font-size: 0.9rem; }
  }
</style>

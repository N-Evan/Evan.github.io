---
import { nowPlaying } from "../../data/now-playing";
const np = nowPlaying;
---
{np.enabled && (
  <aside class="np-widget" aria-label="Currently playing">
    <div class="np-widget__rail" aria-hidden="true"></div>
    <svg class="np-widget__hex" viewBox="0 0 120 120" fill="none" stroke="currentColor" aria-hidden="true">
      <path d="M60 4 L108 32 L108 88 L60 116 L12 88 L12 32 Z" stroke-width="2" />
      <path d="M60 22 L92 41 L92 79 L60 98 L28 79 L28 41 Z" stroke-width="1.5" opacity="0.6" />
      <path d="M60 40 L76 50 L76 70 L60 80 L44 70 L44 50 Z" stroke-width="1.5" opacity="0.4" />
    </svg>
    <div class="np-widget__cover" aria-hidden="true">
      {np.cover ? (
        <img src={np.cover} alt={`${np.game} cover art`} loading="lazy" decoding="async" />
      ) : (
        <span class="np-widget__cover-glyph">▶</span>
      )}
      <span class="np-widget__cover-pulse"></span>
    </div>
    <div class="np-widget__body">
      <div class="np-widget__head">
        <span class="np-widget__dot"></span>
        <span class="np-widget__head-label font-terminal">NOW PLAYING</span>
      </div>
      <div class="np-widget__title font-pixel">{np.game}</div>
      <div class="np-widget__meta font-terminal">
        <span>{np.platform}</span>
        {typeof np.hours === "number" && <span class="np-widget__divider">·</span>}
        {typeof np.hours === "number" && <span>{np.hours}h logged</span>}
      </div>
      {np.status && <p class="np-widget__status font-terminal">&gt; {np.status}</p>}
    </div>
    {np.link && (
      <a href={np.link} target="_blank" rel="noopener noreferrer" class="np-widget__link font-terminal" aria-label="More info">
        ▣
      </a>
    )}
  </aside>
)}

<style>
  /* Dark mode has a starfield and neon bloom behind this panel; light mode
     is bare bone, which left the right-hand side looking empty. */
  .np-widget__hex { display: none; }
  :global(:root[data-theme="light"]) .np-widget__hex {
    display: block;
    position: absolute;
    top: 50%;
    right: 3.2rem;
    transform: translateY(-50%);
    height: 132%;
    width: auto;
    color: var(--accent-bright);
    opacity: 0.16;
    pointer-events: none;
    z-index: 0;
  }
  @media (max-width: 640px) {
    :global(:root[data-theme="light"]) .np-widget__hex { display: none; }
  }

  .np-widget {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85rem;
    width: min(960px, calc(100% - 3rem));
    margin: 1rem auto 0;
    padding: 0.85rem 1rem 0.85rem 1.4rem;
    background: linear-gradient(90deg, color-mix(in srgb, var(--bg-panel) 85%, transparent), color-mix(in srgb, var(--bg-void) 70%, transparent));
    border: 1px solid var(--neon-cyan);
    box-shadow: 0 0 12px color-mix(in srgb, var(--neon-cyan) 18%, transparent);
  }
  .np-widget__rail {
    position: absolute;
    top: 0; bottom: 0; left: 0;
    width: 4px;
    background: var(--neon-cyan);
    box-shadow: 0 0 10px var(--neon-cyan);
  }
  .np-widget__cover {
    position: relative;
    width: 56px;
    height: 56px;
    background: var(--bg-void);
    border: 1px solid var(--neon-magenta);
    box-shadow: 0 0 8px color-mix(in srgb, var(--neon-magenta) 30%, transparent);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .np-widget__cover img {
    width: 100%; height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }
  .np-widget__cover-glyph {
    color: var(--neon-magenta);
    text-shadow: 0 0 8px var(--neon-magenta);
    font-size: 1.5rem;
  }
  .np-widget__cover-pulse {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--neon-magenta) 35%, transparent), transparent 70%);
    animation: np-pulse 2.6s ease-in-out infinite;
    mix-blend-mode: screen;
    pointer-events: none;
  }
  @keyframes np-pulse {
    0%, 100% { opacity: 0.25; }
    50%      { opacity: 0.6;  }
  }
  .np-widget__body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .np-widget__head {
    display: flex; align-items: center; gap: 0.4rem;
  }
  .np-widget__dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--terminal-grn);
    box-shadow: 0 0 6px var(--terminal-grn);
    animation: np-tick 1.4s ease-in-out infinite;
  }
  @keyframes np-tick { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
  .np-widget__head-label {
    color: var(--terminal-grn);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-shadow: 0 0 6px var(--terminal-grn);
  }
  .np-widget__title {
    color: var(--neon-magenta);
    font-size: 0.85rem;
    line-height: 1.2;
    text-shadow: 0 0 6px var(--neon-magenta);
    margin-top: 0.15rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .np-widget__meta {
    color: var(--text-muted);
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    display: flex; gap: 0.4rem;
  }
  .np-widget__divider { color: var(--text-muted); }
  .np-widget__status {
    color: var(--text-soft);
    font-size: 0.92rem;
    margin-top: 0.2rem;
    opacity: 0.8;
  }
  .np-widget__link {
    color: var(--neon-cyan);
    padding: 0.4rem 0.55rem;
    border: 1px dashed var(--neon-cyan);
    text-shadow: 0 0 6px var(--neon-cyan);
    transition: background 200ms, transform 200ms;
  }
  .np-widget__link:hover {
    background: color-mix(in srgb, var(--neon-cyan) 10%, transparent);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .np-widget {
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 0.7rem;
      padding: 0.7rem 0.85rem 0.7rem 1.2rem;
    }
    .np-widget__cover { width: 48px; height: 48px; }
    .np-widget__title { font-size: 0.7rem; }
    .np-widget__link { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .np-widget__cover-pulse, .np-widget__dot { animation: none; }
  }
</style>

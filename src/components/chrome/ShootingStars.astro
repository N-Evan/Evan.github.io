---
// Sparse cyan/magenta shooting-star streaks. ~one every 12s on average.
const trails = [
  { x: 8,  y: 10, delay: 0,  duration: 60, angle: 35, tint: "cyan" },
  { x: 65, y: 18, delay: 12, duration: 60, angle: 32, tint: "white" },
  { x: 35, y: 6,  delay: 24, duration: 60, angle: 40, tint: "cyan" },
  { x: 80, y: 32, delay: 36, duration: 60, angle: 30, tint: "magenta" },
  { x: 22, y: 40, delay: 48, duration: 60, angle: 38, tint: "cyan" },
];
---
<div class="shooters" aria-hidden="true">
  {trails.map((t) => (
    <span
      class={`shooter shooter--${t.tint}`}
      style={`left:${t.x}%;top:${t.y}%;--angle:${t.angle}deg;animation-delay:${t.delay}s;animation-duration:${t.duration}s;`}
    />
  ))}
</div>

<style>
  .shooters {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
  }
  .shooter {
    position: absolute;
    width: 140px;
    height: 1px;
    transform: rotate(var(--angle));
    transform-origin: 0 50%;
    opacity: 0;
    animation: shoot linear infinite;
    will-change: transform, opacity;
  }
  .shooter--cyan {
    background: linear-gradient(90deg, transparent 0%, color-mix(in srgb, var(--neon-cyan) 0%, transparent) 10%, color-mix(in srgb, var(--neon-cyan) 90%, transparent) 88%, #ffffff 100%);
    box-shadow: 0 0 6px color-mix(in srgb, var(--neon-cyan) 70%, transparent);
  }
  .shooter--magenta {
    background: linear-gradient(90deg, transparent 0%, color-mix(in srgb, var(--neon-magenta) 0%, transparent) 10%, color-mix(in srgb, var(--neon-magenta) 90%, transparent) 88%, #ffffff 100%);
    box-shadow: 0 0 6px color-mix(in srgb, var(--neon-magenta) 70%, transparent);
  }
  .shooter--white {
    background: linear-gradient(90deg, transparent 0%, color-mix(in srgb, var(--text-soft) 0%, transparent) 10%, color-mix(in srgb, var(--text-soft) 95%, transparent) 88%, #ffffff 100%);
    box-shadow: 0 0 6px color-mix(in srgb, var(--text-soft) 70%, transparent);
  }
  @keyframes shoot {
    0%   { transform: rotate(var(--angle)) translateX(0);     opacity: 0; }
    1%   { opacity: 1; }
    3.2% { transform: rotate(var(--angle)) translateX(800px); opacity: 0; }
    100% { transform: rotate(var(--angle)) translateX(800px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .shooter { animation: none; opacity: 0; }
  }
</style>

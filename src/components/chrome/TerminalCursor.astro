---
// src/components/chrome/TerminalCursor.astro
---
<span class="cursor" aria-hidden="true">▮</span>

<style>
  .cursor {
    display: inline-block;
    margin-left: 0.15ch;
    color: var(--terminal-grn);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    0%, 49%   { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
</style>

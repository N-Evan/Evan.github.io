---
// src/components/chrome/CRTVignette.astro
// Subtle dark corner vignette + CRT curvature feel.
---
<div class="vignette" aria-hidden="true"></div>

<style>
  .vignette {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 999;
    background:
      radial-gradient(
        ellipse at center,
        transparent 55%,
        rgba(7, 3, 15, 0.65) 100%
      );
  }
</style>

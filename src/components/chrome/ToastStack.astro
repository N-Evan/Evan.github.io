---
// Floating toast container — empty by default. Toasts are appended via JS.
---
<div class="toast-stack" aria-live="polite" aria-atomic="false"></div>

<style is:global>
  .toast-stack {
    position: fixed;
    top: 4rem;
    right: 1.2rem;
    z-index: 9996;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
    pointer-events: none;
    max-width: 360px;
  }
  .pix-toast {
    --tone: var(--neon-magenta);
    pointer-events: auto;
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 0.7rem;
    align-items: center;
    padding: 0.6rem 0.85rem;
    background: linear-gradient(90deg, color-mix(in srgb, var(--bg-panel) 95%, transparent), color-mix(in srgb, var(--bg-void) 95%, transparent));
    border: 1px solid var(--tone);
    border-left: 3px solid var(--tone);
    box-shadow:
      0 0 12px color-mix(in srgb, var(--tone) 40%, transparent),
      0 8px 18px color-mix(in srgb, var(--shadow-base) 60%, transparent);
    color: var(--text-soft);
    opacity: 0;
    transform: translateX(40px);
    transition: opacity 350ms ease, transform 350ms cubic-bezier(.2,.8,.2,1);
    width: 100%;
    font-family: theme("fontFamily.terminal");
  }
  .pix-toast.is-visible {
    opacity: 1;
    transform: translateX(0);
  }
  .pix-toast--magenta { --tone: var(--neon-magenta); }
  .pix-toast--cyan    { --tone: var(--neon-cyan); }
  .pix-toast--yellow  { --tone: var(--neon-yellow); }
  .pix-toast--green   { --tone: var(--terminal-grn); }
  .pix-toast--dota    { --tone: #4eb5b3; }      /* Dota-ish teal */
  .pix-toast--orange  { --tone: #ff9f3f; }      /* warm orange for misc */
  /* Those two are the only literal tones left; on bone they need darkening
     so the icon glyph and border still read. */
  :global(:root[data-theme="light"]) .pix-toast--dota   { --tone: #1f6360; }
  :global(:root[data-theme="light"]) .pix-toast--orange { --tone: #9a5205; }

  /* Flat card, hairline edge — no bloom. */
  :global(:root[data-theme="light"]) .pix-toast {
    background: var(--bg-panel);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--shadow-base) 22%, transparent);
  }
  :global(:root[data-theme="light"]) .pix-toast__icon {
    box-shadow: none;
    color: var(--bg-panel);
  }

  .pix-toast__icon {
    width: 36px; height: 36px;
    display: grid; place-items: center;
    background: var(--tone);
    color: var(--bg-void);
    font-family: theme("fontFamily.pixel");
    font-size: 0.85rem;
    box-shadow: 0 0 8px var(--tone);
  }
  .pix-toast__body { min-width: 0; line-height: 1.25; }
  .pix-toast__title {
    color: var(--tone);
    font-family: theme("fontFamily.pixel");
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-shadow: 0 0 6px var(--tone);
    margin-bottom: 0.2rem;
  }
  .pix-toast__text {
    color: var(--text-soft);
    font-size: 0.95rem;
    letter-spacing: 0.05em;
  }
  @media (prefers-reduced-motion: reduce) {
    .pix-toast { transition: none; }
  }
  @media (max-width: 640px) {
    .toast-stack { top: 3rem; right: 0.6rem; left: 0.6rem; max-width: none; }
  }
</style>

---
// Persistent corner HUD telemetry — fixed-position, decorative.
---
<div class="hud" aria-hidden="true">
  <div class="hud__corner hud__tl">
    <span class="hud__bracket">[</span>
    <span class="hud__label">SYS</span>
    <span class="hud__value" data-clock>--:--:--</span>
    <span class="hud__bracket">]</span>
  </div>
  <div class="hud__corner hud__tr">
    <span class="hud__bracket">[</span>
    <span class="hud__dot"></span>
    <span class="hud__value">LINK::STABLE</span>
    <span class="hud__bracket">]</span>
  </div>
  <div class="hud__corner hud__bl">
    <span class="hud__value">PORTFOLIO.exe v2.0</span>
  </div>
  <div class="hud__corner hud__br">
    <span class="hud__value" data-bars>▁▂▃▅▇▅▃▂</span>
  </div>
</div>

<script>
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const tick = () => {
      const d = new Date();
      const pad = (n: number) => n.toString().padStart(2, '0');
      clock.textContent = `${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}:${pad(d.getUTCSeconds())}Z`;
    };
    tick();
    setInterval(tick, 1000);
  }
  const barsEl = document.querySelector<HTMLElement>('[data-bars]');
  if (barsEl) {
    const frames = ['▁▂▃▅▇▅▃▂', '▂▃▅▇▅▃▂▁', '▃▅▇▅▃▂▁▂', '▅▇▅▃▂▁▂▃', '▇▅▃▂▁▂▃▅'];
    let i = 0;
    setInterval(() => {
      barsEl.textContent = frames[i % frames.length];
      i++;
    }, 280);
  }
</script>

<style>
  .hud {
    position: fixed; inset: 0; pointer-events: none;
    z-index: 998;
    font-family: theme('fontFamily.terminal');
    font-size: 0.85rem; line-height: 1;
    letter-spacing: 0.1em;
  }
  .hud__corner {
    position: absolute; padding: 0.6rem 0.85rem;
    display: flex; align-items: center; gap: 0.45rem;
    opacity: 0.7;
    text-transform: uppercase;
  }
  .hud__tl { top: 0; left: 0; color: var(--neon-cyan); }
  .hud__tr { top: 0; right: 0; color: var(--neon-magenta); }
  .hud__bl { bottom: 0; left: 0; color: var(--text-muted); }
  .hud__br { bottom: 0; right: 0; color: var(--terminal-grn); }
  .hud__bracket { color: currentColor; opacity: 0.6; }
  .hud__label { color: var(--text-muted); }
  .hud__value { text-shadow: 0 0 6px currentColor; }
  .hud__dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 8px currentColor, 0 0 12px currentColor;
    animation: hud-pulse 1.6s ease-in-out infinite;
  }
  @keyframes hud-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.85); }
  }
  @media (max-width: 640px) {
    .hud { font-size: 0.65rem; }
    .hud__bl, .hud__br { display: none; }
  }
</style>
